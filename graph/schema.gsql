// ============================================================================
// TigerGraph Schema Definition for Agentic Fraud Investigation (HHGOA IEEE Edition)
// Graph Name: FraudInvestigationGraph
// ============================================================================

CREATE GRAPH FraudInvestigationGraph ()

// ----------------------------------------------------------------------------
// Vertices
// ----------------------------------------------------------------------------

// Customer Entity
CREATE VERTEX Customer (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Payment Card Entity
CREATE VERTEX Card (
    PRIMARY_ID id STRING,
    card1 STRING,
    card2 STRING,
    card4 STRING,
    card6 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Transaction Entity
CREATE VERTEX Transaction (
    PRIMARY_ID id STRING,
    amt DOUBLE,
    ts DATETIME,
    epoch_sec INT,
    channel STRING,
    risk_score DOUBLE,
    product_cd STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Device Profile Entity (DeviceInfo + OS + browser + screen)
CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen STRING,
    device_type STRING,
    is_new STRING,
    proxy STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Purchaser Email Domain Entity
CREATE VERTEX EmailDomain (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Billing Region (addr1)
CREATE VERTEX BillingRegion (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Historical Closed Cases (Case Memory: 5,565 closed investigations)
CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    first_fraud_txn_id STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Active/Resolved Investigation Cases (Dynamic Graph Case Memory)
CREATE VERTEX FraudCase (
    PRIMARY_ID id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    status STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    stop_reason STRING,
    summary STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";


// ----------------------------------------------------------------------------
// Edges
// ----------------------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="USED_IN_TXN";
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="USED_BY_TXN";
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="TXN_BILLED_HERE";
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction);

// Closed Case Connections (Historical Case Memory)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN_CASE";
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="HAD_CLOSED_CASE";
CREATE UNDIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

// Active/Resolved Case Connections (Live Graph Case Memory)
CREATE DIRECTED EDGE CASE_INVOLVES (FROM FraudCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN_FRAUD_CASE";
CREATE DIRECTED EDGE CASE_ON_CARD (FROM FraudCase, TO Card) WITH REVERSE_EDGE="HAD_FRAUD_CASE";
CREATE UNDIRECTED EDGE CASE_CONNECTED_CARD (FROM FraudCase, TO Card);
CREATE DIRECTED EDGE CASE_CONNECTED_DEVICE (FROM FraudCase, TO DeviceProfile);
